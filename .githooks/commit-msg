#!/usr/bin/env sh
set -eu

MSG_FILE="${1:-}"

if [ -z "$MSG_FILE" ] || [ ! -f "$MSG_FILE" ]; then
  echo "commit-msg hook: missing commit message file" >&2
  exit 1
fi

HEADER="$(head -n 1 "$MSG_FILE" | tr -d '\r')"

# Allow messages generated by git tooling.
case "$HEADER" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *)
    exit 0
    ;;
esac

# Conventional Commits 1.0.0
# <type>[optional scope][!]: <description>
PATTERN='^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\([a-z0-9][a-z0-9._/-]*\))?(!)?: .+$'

if ! printf '%s\n' "$HEADER" | grep -Eq "$PATTERN"; then
  cat >&2 <<'EOF'
Invalid commit message header.

Expected format:
  <type>[optional scope][!]: <description>

Examples:
  feat(mobile): add stock sync worker
  fix(backend)!: change pedidos endpoint validation
  docs: update technical test notes

Allowed types:
  build, chore, ci, docs, feat, fix, perf, refactor, revert, style, test
EOF
  exit 1
fi
